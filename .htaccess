---
permalink: /.htaccess
---
# Apache: serve /feed/ from feed/index.xml and use the themed 404 page.
DirectoryIndex index.html index.xml
ErrorDocument 404 /404.html
AddType application/rss+xml .xml

# Old WordPress file URLs -> assets/ (generated from _data/moved_files.json)
{% for f in site.data.moved_files -%}
Redirect 301 "{{ f.from }}" "{{ f.to }}"
{% endfor -%}
